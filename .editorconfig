root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sp,inc,cfg,res,kv,vmt,c,cpp,h,hpp}]
indent_style = tab
indent_size = 4
tab_width = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{json,yml,yaml,md,txt,sh,xml,html,css,js,ts}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
indent_style = tab
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false
